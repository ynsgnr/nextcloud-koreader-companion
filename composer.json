{
    "name": "international-omelette/nextcloud-koreader-companion",
    "description": "Transform your Nextcloud into an authenticated OPDS ebook library with full KOReader sync support.",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Dominik Fischer",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "kiwilan/php-archive": "^2.0",
        "smalot/pdfparser": "^2.12",
        "symfony/html-sanitizer": "^7.4",
        "league/uri": "^7.8",
        "masterminds/html5": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "OCA\\KoreaderCompanion\\": "lib/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.99"
        }
    },
    "require-dev": {
        "vimeo/psalm": "^6.16",
        "symfony/console": "~6.4.41",
        "symfony/filesystem": "~7.4.8",
        "symfony/string": "~7.4.13"
    }
}
